{
  "name": "ferramenta-da-qa",
  "version": "1.2.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "description": "Ferramenta da QA para organizar requisitos em cenários de teste.",
  "author": "Erica Souza",
  "repository": {
    "type": "git",
    "url": "https://github.com/ericasouzaqa/Ferramenta-da-QA.git"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "vite preview",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "desktop:dev": "pnpm build --mode desktop && electron desktop/main.cjs",
    "desktop:win": "pnpm build --mode desktop && electron-builder --win portable"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "read-excel-file": "9.3.10",
    "sonner": "^2.0.7",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.4"
  }
}
